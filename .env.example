DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/dbname?sslmode=require
AUTH_SECRET=generate-a-32-byte-hex-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Neon Auth (powered by Stack) — lấy ở Neon dashboard → Auth
# Client (browser) cần prefix NEXT_PUBLIC_ để Next expose xuống client
NEXT_PUBLIC_NEON_AUTH_URL=
# Server app đọc biến này (fallback NEXT_PUBLIC_*)
NEON_AUTH_URL=
# Token riêng cho cron. Bắt buộc trên production để /api/cron không bị gọi giả mạo.
CRON_SECRET=
# URL công khai của app — Neon Auth check trusted_origins theo origin này.
# Bắt buộc trên production (middleware + proxy dùng để gửi Origin đúng)
NEON_PUBLIC_APP_URL=
